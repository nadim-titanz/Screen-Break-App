<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_bg_app_stats"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_nothing_background"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SCREEN TIME"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.08" />

            <ImageView
                android:id="@+id/refresh_stats_screentime"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Refresh screentime"
                android:src="@drawable/ic_widget_refresh" />
        </LinearLayout>

        <TextView
            android:id="@+id/screentime_widget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp"
            android:singleLine="true"
            android:text="0m"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/app_1_sm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="2dp"
            android:singleLine="true"
            android:text="--"
            android:textColor="#CCCCCC"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/app_2_sm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="2dp"
            android:singleLine="true"
            android:text="--"
            android:textColor="#888888"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/app_3_sm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="2dp"
            android:singleLine="true"
            android:text="--"
            android:textColor="#888888"
            android:textSize="11sp"
            android:fontFamily="monospace" />

    </LinearLayout>
</FrameLayout>
